# Local development defaults. For VPS Docker deployment, set SENTINEL_DOMAIN and
# a strong AUDIT_SECRET here; docker-compose.yml binds the app privately and Caddy
# provides HTTPS. Never commit the real .env file or credentials.
AUDIT_HOST=127.0.0.1
AUDIT_PORT=8080
AUDIT_DB=data/audit.db
# Generate a secret in PowerShell:
# $bytes = New-Object 'System.Byte[]' 48
# $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $rng.GetBytes($bytes)
# [Convert]::ToBase64String($bytes)
# $rng.Dispose()
AUDIT_SECRET=
AUDIT_PUBLIC_URL=http://localhost:8080
AUDIT_COOKIE_SECURE=0
# Cloud/VPS private scopes require an online organization scanner agent.
AUDIT_REQUIRE_SCANNER_AGENT=0
TRUST_PROXY_HEADERS=0
LOG_LEVEL=INFO

# VPS HTTPS hostname: replace with a DNS name whose A/AAAA records point to the VPS.
SENTINEL_DOMAIN=sentinel.example.com

# SMTP password reset, invitations, and legacy email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Sentinel Audit <no-reply@example.com>"
SMTP_STARTTLS=true
SMTP_SSL=false

# Cloudflare Turnstile (used for repeated login failures and legacy verification resend)
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=


# Nmap service/version collection
NMAP_PATH=
AUDIT_NMAP_FULL_TCP=true
AUDIT_NMAP_UDP_TOP=100
AUDIT_NMAP_UDP_PORTS=
NMAP_TIMEOUT=900
NMAP_TCP_TIMEOUT=180
NMAP_UDP_TIMEOUT=45
NMAP_DISCOVERY_TIMEOUT=15

# NIST NVD enrichment
NVD_API_KEY=
NVD_TIMEOUT=20
NVD_RESULTS_PER_PAGE=20
